# 이 파일을 복사해 .env 를 만들고 값을 채운다. .env 는 절대 커밋하지 않는다.
# 실제 값은 팀 비공개 채팅으로만 주고받는다.

# DB (로컬은 docker-compose.yml 값)
DB_URL=jdbc:mysql://localhost:3306/maco?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USER=maco
DB_PASSWORD=

# 로그인
JWT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 가게 검색 (네이버 검색 API - 지역)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# AI (키가 없으면 AI_MODE=recorded 로 실행)
AI_MODE=recorded
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_TEXT=
AI_MODEL_VISION=

# 업로드 폴더 (S3 대신 서버 디스크)
UPLOAD_DIR=./uploads

# 콘텐츠 CSV 폴더 (backend 기준 상대 경로), 프론트 주소 (CORS)
CONTENT_DIR=../content
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 시연 계정 비밀번호 (local 프로필에서 예시 계정 만들 때). 바꿀 때만 주석을 풀고 값을 넣는다
# DEMO_PASSWORD=

# 프론트 (frontend/.env.local 에 넣는다)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# true면 서버 없이 목업 데이터로 화면이 돈다
NEXT_PUBLIC_API_MOCK=false
