{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "화면 이전 실행 끄기",
      "detail": "이미 켜져 있는 화면 서버(next dev)가 있으면 끈다 (한 폴더에 하나만 켤 수 있음)",
      "type": "npm",
      "script": "stop-dev",
      "path": "frontend",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "화면 패키지 설치",
      "detail": "frontend 의존성 설치 (이미 설치돼 있으면 몇 초면 끝남)",
      "type": "npm",
      "script": "install",
      "path": "frontend",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "화면 준비",
      "detail": "이전 화면 서버 끄기 → 패키지 설치",
      "dependsOn": [
        "화면 이전 실행 끄기",
        "화면 패키지 설치"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "DB 켜기",
      "detail": "Docker Desktop이 켜져 있어야 한다. MySQL이 접속을 받을 준비가 될 때까지 기다린다",
      "type": "shell",
      "command": "docker compose up -d --wait",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "DB 끄기",
      "type": "shell",
      "command": "docker compose stop",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "검사: 규칙 (check-rules)",
      "type": "shell",
      "command": "node scripts/check-rules.mjs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "검사: 화면 (lint + build)",
      "type": "npm",
      "script": "build",
      "path": "frontend",
      "dependsOn": [
        "검사: 화면 lint"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "검사: 화면 lint",
      "type": "npm",
      "script": "lint",
      "path": "frontend",
      "problemMatcher": []
    },
    {
      "label": "검사: 서버 테스트",
      "type": "shell",
      "command": "./gradlew test",
      "windows": {
        "command": ".\\gradlew.bat test"
      },
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "화면 끄기",
      "detail": "■로 멈췄는데도 화면이 계속 켜져 있을 때",
      "type": "npm",
      "script": "stop-dev",
      "path": "frontend",
      "problemMatcher": []
    }
  ]
}
