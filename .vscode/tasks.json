{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "화면 패키지 설치",
      "detail": "frontend 의존성 설치 (이미 설치돼 있으면 몇 초면 끝남)",
      "type": "npm",
      "script": "install",
      "path": "frontend",
      "presentation": { "reveal": "silent", "close": true },
      "problemMatcher": []
    },
    {
      "label": "DB 켜기",
      "detail": "Docker Desktop이 켜져 있어야 한다",
      "type": "shell",
      "command": "docker compose up -d",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "close": true },
      "problemMatcher": []
    },
    {
      "label": "DB 끄기",
      "type": "shell",
      "command": "docker compose stop",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "검사: 규칙 (check-rules)",
      "type": "shell",
      "command": "node scripts/check-rules.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "검사: 화면 (lint + build)",
      "type": "npm",
      "script": "build",
      "path": "frontend",
      "dependsOn": ["검사: 화면 lint"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "검사: 화면 lint",
      "type": "npm",
      "script": "lint",
      "path": "frontend",
      "problemMatcher": []
    },
    {
      "label": "검사: 서버 테스트",
      "type": "shell",
      "command": "./gradlew test",
      "windows": { "command": ".\\gradlew.bat test" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
