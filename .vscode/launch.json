{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① 화면 - 목업 모드 (서버 없이)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:mock",
      "cwd": "${workspaceFolder}/frontend",
      "preLaunchTask": "화면 패키지 설치",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s/training",
        "action": "openExternally"
      }
    },
    {
      "name": "② 화면 - 실제 서버 연결",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend",
      "preLaunchTask": "화면 패키지 설치",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "③ 서버 - Spring Boot (DB 필요)",
      "type": "node-terminal",
      "request": "launch",
      "command": "./gradlew bootRun",
      "windows": {
        "command": ".\\gradlew.bat bootRun"
      },
      "cwd": "${workspaceFolder}/backend",
      "preLaunchTask": "DB 켜기",
      "serverReadyAction": {
        "pattern": "Started MacoApplication",
        "uriFormat": "http://localhost:8080/swagger-ui",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "★ 전체 실행 (DB + 서버 + 화면)",
      "configurations": ["③ 서버 - Spring Boot (DB 필요)", "② 화면 - 실제 서버 연결"],
      "stopAll": true
    }
  ]
}
