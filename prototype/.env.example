# 마코 로그인 설정 예시. 실제 값은 .env.local 에 넣으세요 (npm run setup 이 만들어 줘요).

# 세션 암호화 키. npm run setup 이 무작위로 만들어요.
AUTH_SECRET=

# 카카오 로그인: developers.kakao.com 에서 발급한 값을 넣고 서버를 다시 켜세요.
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# 네이버 로그인: developers.naver.com 에서 발급한 값.
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# 가게 검색(네이버 검색 API · 지역). 비워 두면 시연용 예시 가게가 나와요.
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=

# Apple 로그인: Apple Developer 계정의 Services ID와 client secret. HTTPS 주소에서만 동작해요.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# 최종 시연 때 테스트 계정을 숨기려면 off
MACO_TEST_LOGIN=
